# Copy to .env and fill in what you need. None of this is required for ordinary
# frontend work — the diff engine, sharing, export and folder comparison all run
# without a backend.
#
# .env is gitignored. Never commit real values.

# ---------------------------------------------------------------------------
# Frontend (VITE_ prefixed vars are inlined into the client bundle at build
# time — never put a secret here, it ships to every visitor)
# ---------------------------------------------------------------------------

# Set to "true" once the Node backend (Socket.IO multiplayer + Gemini proxy in
# server.ts) is deployed somewhere reachable. Leave false/unset for the static
# GitHub Pages build, where those features are greyed out in the UI.
VITE_ENABLE_SERVER_FEATURES=false

# ---------------------------------------------------------------------------
# Backend — server.ts only. Not used by the GitHub Pages build.
# ---------------------------------------------------------------------------

# Google Gemini key, used server-side for AI-assisted conflict resolution.
# This IS a secret. It is only ever read in server.ts and must not reach the
# client. The endpoint that uses it is rate limited to 10 req/IP/min.
GEMINI_API_KEY=

# Comma-separated origins allowed to open Socket.IO connections.
# Defaults to http://localhost:3000 when unset.
# Set this before exposing the server publicly — a wildcard would let any page
# on the internet connect and join multiplayer rooms.
# Example: ALLOWED_ORIGINS=https://solopass.github.io,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Port for server.ts. Defaults to 3000.
PORT=3000

# ---------------------------------------------------------------------------
# Not configured here
# ---------------------------------------------------------------------------
# Firebase web config lives in firebase-applet-config.json, which is committed
# on purpose — it is a public identifier, not a credential. Access is controlled
# by firestore.rules. See SECURITY.md.
