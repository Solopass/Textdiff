+  const handleExportPatch = () => {
+    if (!diffResult) return;
+    let patchStr = `--- Original\n+++ Modified\n`;
+    let currentChunk = [];
+    // simple pseudo-patch for demo
+    diffResult.forEach(row => {
+      if (row.type === 'unchanged') {
+        patchStr += ` ${row.lineA}\n`;
