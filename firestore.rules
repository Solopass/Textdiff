rules_version = '2';

// Shared diffs are anonymous and unauthenticated by design — anyone with the
// link can open one. The rules therefore cannot do identity checks; what they
// CAN do is bound the damage:
//
//   * reads are per-document only. `get` is allowed, `list` is not, so a
//     client cannot enumerate the collection and harvest every diff people
//     have ever shared. Document IDs are Firestore auto-IDs (20 chars over a
//     ~62-symbol alphabet), so they are not practically guessable.
//   * creates are size-capped and shape-checked, so the collection cannot be
//     used as free unbounded storage or to run up the bill.
//   * creates must carry an expiry, bounded to at most ~31 days out, so a
//     client cannot mint a link that outlives the retention policy.
//   * updates are refused. A shared link is immutable; nobody should be able
//     to overwrite the contents of a URL someone else has already circulated.
//
// If accounts are added later, tighten `get` to an owner check plus an
// explicit `public` flag.

service cloud.firestore {
  match /databases/{database}/documents {
    match /diffs/{diffId} {

      // Single-document reads only — `list` stays denied.
      //
      // Expiry is NOT enforced here. Rules can't compare against wall-clock
      // "now" for a `get` without forcing every read through a query, and a
      // client that ignored the result would gain nothing anyway: the data is
      // already in its hands. Expiry is enforced two places that matter — the
      // app refuses to render an expired document, and the scheduled cleanup
      // job deletes it. See SECURITY.md.
      allow get: if true;
      allow list: if false;

      allow create: if
        // Payload shape is fixed. Anything else is rejected.
        request.resource.data.keys().hasOnly(['data', 'timestamp', 'expiresAt', 'burnAfterReading'])
        && request.resource.data.data is string
        && (!('burnAfterReading' in request.resource.data)
            || request.resource.data.burnAfterReading == true)
        // ~900KB ceiling, just under Firestore's 1MiB document limit. Large
        // enough for any realistic diff, small enough to bound abuse.
        && request.resource.data.data.size() < 900000
        && request.resource.data.timestamp is number
        && request.resource.data.expiresAt is number
        // Must expire in the future, and no more than ~31 days out. The app
        // uses 30 days; the extra day absorbs clock skew between the client
        // and the server rather than rejecting honest requests.
        && request.resource.data.expiresAt > request.resource.data.timestamp
        && request.resource.data.expiresAt <=
             request.resource.data.timestamp + 2678400000;

      // Shares are write-once. Ordinary deletion is performed by the cleanup
      // job using the Admin SDK, which bypasses these rules.
      allow update: if false;

      // Burn-after-reading: the reader's client deletes the share once it has
      // decrypted it. Anyone holding the link may delete — the document ID is
      // the capability, exactly as it is for reading. Shares without the flag
      // stay undeletable by clients.
      allow delete: if resource.data.get('burnAfterReading', false) == true;
    }

    // The public Diff Feed. Unlike `diffs`, this is meant to be browsed, so
    // `list` is allowed — but only in pages of at most 50. Limits mirror
    // src/lib/feed.ts; change both together.
    match /diff_feed/{postId} {
      allow get: if true;
      allow list: if request.query.limit <= 50;

      allow create: if
        request.resource.data.keys().hasOnly(
          ['author', 'caption', 'tags', 'timestamp', 'stats', 'hunk', 'fileName', 'fullShareId'])
        && request.resource.data.keys().hasAll(['author', 'caption', 'tags', 'timestamp', 'stats'])
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 2
        && request.resource.data.author.size() <= 30
        && request.resource.data.author.matches('@[A-Za-z0-9_.-]+')
        && request.resource.data.caption is string
        && request.resource.data.caption.size() >= 1
        && request.resource.data.caption.size() <= 280
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        // The server's clock only: no backdating, no future-dating to stay on top.
        && request.resource.data.timestamp == request.time
        && request.resource.data.stats is map
        && request.resource.data.stats.keys().hasOnly(['additions', 'deletions', 'similarity', 'language'])
        && request.resource.data.stats.additions is int
        && request.resource.data.stats.deletions is int
        && request.resource.data.stats.similarity is int
        && request.resource.data.stats.language is string
        && request.resource.data.stats.language.size() <= 20
        && (!('hunk' in request.resource.data)
            || (request.resource.data.hunk is string && request.resource.data.hunk.size() <= 2000))
        && (!('fileName' in request.resource.data)
            || (request.resource.data.fileName is string && request.resource.data.fileName.size() <= 100))
        && (!('fullShareId' in request.resource.data)
            || (request.resource.data.fullShareId is string && request.resource.data.fullShareId.size() <= 40));

      // Posts are permanent and immutable from the client. Moderation, if it
      // is ever needed, goes through the Admin SDK.
      allow update, delete: if false;
    }
  }
}
